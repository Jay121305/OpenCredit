# =============================================================================
# OpenCredit Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control!
#
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=OpenCredit
ENV=dev
API_PREFIX=/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Security (REQUIRED - Generate your own secrets!)
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────
# For Docker: postgresql+psycopg://USER:PASSWORD@postgres:5432/DB
# For local dev: sqlite:///./opencredit.db
POSTGRES_DB=opencredit
POSTGRES_USER=opencredit
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
STREAM_NAME=opencredit.transactions
STREAM_MAX_LEN=10000

# ─────────────────────────────────────────────────────────────────────────────
# Idempotency Settings
# ─────────────────────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────────
# Credit & Business Rules
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_CREDIT_LIMIT=5000.0
MAX_TRANSACTION_AMOUNT=10000.0

# ─────────────────────────────────────────────────────────────────────────────
# Fraud Detection Configuration
# ─────────────────────────────────────────────────────────────────────────────
HIGH_VALUE_THRESHOLD=5000
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_TXN_COUNT=5

# Fraud score weights (0.0 - 1.0)
FRAUD_WEIGHT_HIGH_VALUE=0.45
FRAUD_WEIGHT_VELOCITY=0.25
FRAUD_WEIGHT_GEO_MISMATCH=0.10
FRAUD_WEIGHT_ML_MAX=0.30

# Fraud decision thresholds
FRAUD_THRESHOLD_REJECT=0.75
FRAUD_THRESHOLD_FLAG=0.50

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_PAYMENTS=100/minute
RATE_LIMIT_DEFAULT=60/minute

# ─────────────────────────────────────────────────────────────────────────────
# CORS (comma-separated origins for production)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
