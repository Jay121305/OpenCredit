# =============================================================================
# Render.com Environment Variables Template
# =============================================================================
# This file shows what environment variables to set in Render dashboard.
# DO NOT commit secrets to Git!
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Required Secrets (Set in Render Dashboard)
# ─────────────────────────────────────────────────────────────────────────────

# Generate JWT secret with: openssl rand -hex 32
JWT_SECRET=<GENERATE_IN_RENDER_DASHBOARD>

# PostgreSQL password (auto-generated by Render when you create DB)
POSTGRES_PASSWORD=<AUTO_SET_BY_RENDER>

# Redis URL (if using external Redis like Upstash - free tier)
# Get free Redis at: https://upstash.com/
# Format: rediss://default:PASSWORD@HOST:PORT
REDIS_URL=<OPTIONAL_UPSTASH_REDIS_URL>

# ─────────────────────────────────────────────────────────────────────────────
# Auto-Configured by render.yaml
# ─────────────────────────────────────────────────────────────────────────────
# These are set automatically from render.yaml:
# - ENV=production
# - APP_NAME=OpenCredit
# - API_PREFIX=/api/v1
# - DATABASE_URL (auto-set by Render PostgreSQL)
# - All fraud detection and rate limiting settings
